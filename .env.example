# CAT PRO Compose host settings. Copy this file to .env on the VPS.
# Keep the gateway bound to loopback behind a host-managed HTTPS reverse proxy.
CAT_PRO_PUBLIC_ORIGIN=https://cat-pro.example.com
CAT_PRO_BIND_ADDRESS=127.0.0.1
CAT_PRO_HTTP_PORT=8080

# Keep blank for SHADOW. Set only for the explicit PAPER overlay after
# every read-only PAPER readiness prerequisite has passed.
CAT_PRO_PAPER_CONFIRMATION=

# Optional backend Strategy #2-#8 SHADOW/PAPER controls are documented in
# backend/.env.example. LIVE is not controlled by these variables.
CAT_PRO_SHADOW_STRATEGIES=
CAT_PRO_CENTRAL_PAPER_CONFIRMATION=
CAT_PRO_CENTRAL_PAPER_STRATEGIES=

# LIVE-only overlay host values. Capital Manager caps are USDT-denominated;
# withdrawal destinations remain in backend/.env and are never committed.
CAT_PRO_REBALANCER_MAX_PER_TRANSFER_USDT=10
CAT_PRO_REBALANCER_MAX_PER_DAY_SAME_EXCHANGE_USDT=60
CAT_PRO_REBALANCER_MAX_PER_DAY_CROSS_EXCHANGE_USDT=60
CAT_PRO_REBALANCER_WITHDRAWAL_WHITELIST_JSON=[]
