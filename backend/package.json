{
  "name": "crypto-arbitrage-scanner",
  "version": "1.0.0",
  "description": "Professional Crypto Arbitrage Scanner",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node src/server.ts",
    "dev:watch": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "npm run build && npm run test:deterministic",
    "test:deterministic": "node dist/scripts/runDeterministicTests.js",
    "benchmark:vwap": "tsx tests/runners/VWAPBenchmarkRunner.ts",
    "benchmark:opportunity": "node -r ts-node/register tests/runners/OpportunityPipelineBenchmarkRunner.ts",
    "benchmark:all": "npm run benchmark:vwap && npm run benchmark:opportunity"
  },
  "keywords": [
    "crypto",
    "arbitrage",
    "coindcx"
  ],
  "author": "Puneet Basumatary",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.18.1",
    "coindcx-socketio-client": "npm:socket.io-client@2.4.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "winston": "^3.19.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.1.0",
    "@types/ws": "^8.18.1",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.8",
    "typescript": "^5.9.2"
  }
}
