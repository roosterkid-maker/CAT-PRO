# Server
NODE_ENV=development
PORT=5000
CAT_PRO_BACKEND_HOST=127.0.0.1
BINANCE_MAX_MARKETS=200
FRONTEND_ORIGIN=http://localhost:5173

# Live execution safety
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
CAT_PRO_PRIVATE_FILL_STREAMS_ENABLED=false
BINANCE_PUBLIC_REST_BASE_URL=https://data-api.binance.vision
BINANCE_PUBLIC_WEBSOCKET_URL=wss://data-stream.binance.vision:443/ws
ARBITRAGE_LIVE_CONFIRMATION=
STRATEGY_ONE_LIVE_RUNTIME_CONFIRMATION=

# CoinDCX
COINDCX_API_KEY=
COINDCX_API_SECRET=

# Binance
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Bybit
BYBIT_API_KEY=
BYBIT_API_SECRET=

# CoinSwitch read-only account evidence
COINSWITCH_API_KEY=
COINSWITCH_API_SECRET=

# UnoCoin read-only account-status evidence
UNOCOIN_API_TOKEN=

# Strategy #1 bounded CoinDCX/UnoCoin discovery cadence. These controls never
# bypass quantity, freshness, fee, persistence, liquidity, or LIVE safety gates.
UNOCOIN_MAX_ORDER_BOOK_MARKETS=12
UNOCOIN_MAX_CONCURRENT_BOOK_READS=6
UNOCOIN_ORDER_BOOK_REFRESH_MS=1000
COINSWITCH_MAX_SUBSCRIBED_MARKETS=180
COINDCX_STRATEGY_ONE_REST_MARKETS=24
COINDCX_PROTECTED_REST_MAX_CONCURRENT_READS=6
CAT_PRO_STRATEGY_ONE_SCAN_INTERVAL_MS=1000
CAT_PRO_STRATEGY_ONE_MIN_EVENT_SCAN_INTERVAL_MS=10

# Execution
EXECUTION_TIMEOUT_MS=15000
EXECUTION_POLLING_INTERVAL_MS=1000
EXECUTION_CANCEL_ON_TIMEOUT=true

# Opportunity engine
MAXIMUM_QUOTE_AGE_MS=5000
MINIMUM_NET_PROFIT_PERCENT=0.1
MINIMUM_LIQUIDITY_PERCENT=100

# Logging
# Keep normal deployments at info. debug enables verbose per-opportunity rejection payloads.
LOG_LEVEL=info
LOG_DIRECTORY=logs

# Optional Strategy #2-#8 SHADOW controllers. Comma-separated canonical IDs.
# Example: triangular-arbitrage,spot-perpetual-basis-arbitrage,funding-rate-arbitrage,perpetual-perpetual-arbitrage,dynamic-market-making,statistical-arbitrage
CAT_PRO_SHADOW_STRATEGIES=

# Strategy #2 requires all fields before its SHADOW controller can start.
CAT_PRO_XEMM_MAKER_EXCHANGE=
CAT_PRO_XEMM_HEDGE_EXCHANGE=
# Optional ordered failover allow-list. When present, it replaces the legacy
# maker/hedge pair above. Format: maker>hedge,maker>hedge
CAT_PRO_XEMM_VENUE_PAIRS=
CAT_PRO_XEMM_MARKETS=
CAT_PRO_XEMM_QUANTITY=
CAT_PRO_XEMM_MINIMUM_RETAINED_EDGE_PERCENT=
CAT_PRO_XEMM_ROUTE_MINIMUM_CONSECUTIVE_PASSES=3
CAT_PRO_XEMM_ROUTE_MINIMUM_DWELL_MS=2000
CAT_PRO_XEMM_ROUTE_FAILOVER_COOLDOWN_MS=5000

# Central PAPER remains disabled unless the exact confirmation and an
# allowlist are both present. This never enables LIVE.
CAT_PRO_CENTRAL_PAPER_CONFIRMATION=
CAT_PRO_CENTRAL_PAPER_STRATEGIES=

# Strategy #1's existing unified PAPER owner has a separate explicit arm.
# Set only for intentional PAPER execution after readiness gates pass.
AUTOMATED_PAPER_TRADING_CONFIRMATION=

# Explicit linear-perpetual cost evidence, expressed as percent per side.
# Use the operator/account rates that apply to the deployment. Missing or
# partial values fail closed; these values never grant LIVE authority.
BINANCE_USDM_MAKER_FEE_PERCENT=
BINANCE_USDM_TAKER_FEE_PERCENT=
BYBIT_LINEAR_MAKER_FEE_PERCENT=
BYBIT_LINEAR_TAKER_FEE_PERCENT=
