# Local development and container deployment use the browser's current origin.
# Vite proxies local /api and /socket.io traffic to the backend on port 5000;
# the production gateway performs the same routing without exposing port 5000.
VITE_API_BASE_URL=
VITE_SOCKET_URL=
VITE_APP_NAME=CAT PRO
VITE_APP_VERSION=3.0.0
